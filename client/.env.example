# Optional backend target for the Vite development proxy
API_PROXY_TARGET=http://localhost:4001
# Optional direct API URL for deployments; defaults to /api
VITE_API_URL=
# Proctoring: MediaPipe Face Landmarker runs in the candidate's browser. By default the
# WASM runtime loads from jsDelivr and the model from Google's model bucket. To self-host,
# copy node_modules/@mediapipe/tasks-vision/wasm to a static folder and point these at it.
VITE_PROCTOR_WASM_URL=
VITE_PROCTOR_MODEL_URL=
