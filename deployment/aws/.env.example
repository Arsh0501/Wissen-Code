# Copy to .env.aws at the repository root ON EC2. Never commit the copy.
API_HOST=replace-with-your-name.duckdns.org
# Set these to the actual frontend origin (Vercel or Render), without a trailing slash.
APP_URL=https://replace-with-your-site.onrender.com
CORS_ORIGINS=https://replace-with-your-site.onrender.com

# Generate a hexadecimal password; put the SAME password in both fields.
POSTGRES_PASSWORD=replace-with-generated-hex-password
DATABASE_URL=postgresql://wissen:replace-with-generated-hex-password@postgres:5432/wissen_code?schema=public
JWT_SECRET=replace-with-at-least-32-random-characters
MONITORING_TOKEN=replace-with-another-random-secret
INTERVIEW_REPORT_FONT=/usr/share/fonts/truetype/noto/NotoSans-Regular.ttf

# Only backend containers receive these. Copy the working provider/model from local setup.
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
JUDGE0_API_URL=https://ce.judge0.com
JUDGE0_API_KEY=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=replace-with-your-sender@gmail.com
SMTP_PASS=replace-with-your-google-app-password
MAIL_FROM=replace-with-your-sender@gmail.com
MAIL_FROM_NAME="Wissen Code"
MAIL_TIMEZONE=Asia/Kolkata

TRANSCRIPTION_TOKEN=replace-with-a-long-random-secret
WHISPER_MODEL=base.en
WHISPER_LANGUAGE=en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# STUN helps discover a direct route; add your TURN configuration for restrictive networks.
WEBRTC_ICE_SERVERS='[{"urls":"stun:stun.l.google.com:19302"}]'
