DATABASE_URL="postgresql://wissen:wissen-local-dev@localhost:5432/wissen_code?schema=public"
JWT_SECRET=""
PORT=4001
REDIS_URL="redis://localhost:6379"

# Use live mode for real execution and generated-question approval.
JUDGE_MODE=mock
JUDGE0_API_URL="https://ce.judge0.com"

# Optional AI workflows; never expose this key to the frontend.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"
# Free / self-hosted providers that speak the OpenAI dialect. Setting a base URL switches the
# gateway to Chat Completions (OPENAI_API_STYLE=responses forces the Responses API).
#   Groq (free tier):   OPENAI_BASE_URL="https://api.groq.com/openai/v1"      OPENAI_MODEL="openai/gpt-oss-120b"
#   Gemini (free tier): OPENAI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"  OPENAI_MODEL="gemini-2.5-flash"
#   Ollama (local):     OPENAI_BASE_URL="http://localhost:11434/v1"  OPENAI_API_KEY="ollama"  OPENAI_MODEL="qwen2.5-coder:7b"
# OPENAI_BASE_URL=""
# OPENAI_API_STYLE=""

# Deployment and frontend origins (comma-separated, no trailing slash).
APP_URL="http://localhost:3000"
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"
TRUST_PROXY=0
JUDGE0_API_KEY=""

# Optional durable invitation/recovery/OTP email delivery. The API drains the outbox
# itself every 10s; set OUTBOX_INLINE=false to leave delivery to npm run worker:mail.
# OUTBOX_INLINE=true
# Nodemailer is used when Gmail OAuth or SMTP is configured; otherwise Resend.
MAIL_FROM=""
MAIL_FROM_NAME="Wissen Code"
MAIL_TIMEZONE="Asia/Kolkata"

# Gmail via Google Cloud Console OAuth client (APIs & Services > Credentials).
# Enable the Gmail API, create an OAuth client, then generate a refresh token for
# GOOGLE_MAIL_USER (e.g. via OAuth Playground with scope https://mail.google.com/).
GOOGLE_MAIL_USER=""
GOOGLE_MAIL_CLIENT_ID=""
GOOGLE_MAIL_CLIENT_SECRET=""
GOOGLE_MAIL_REFRESH_TOKEN=""

# SMTP fallback (e.g. Gmail app password: smtp.gmail.com, port 465).
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""

RESEND_API_KEY=""

# Optional company SSO. Create staff accounts before their first SSO login.
OIDC_ISSUER=""
OIDC_CLIENT_ID=""
OIDC_CLIENT_SECRET=""

# Optional private video relay configuration; use your own STUN/TURN service.
WEBRTC_ICE_SERVERS='[]'

# Optional signed ATS event notifications.
ATS_WEBHOOK_URL=""
ATS_WEBHOOK_SECRET=""

# Protects the Prometheus metrics endpoint; use a separate random secret.
MONITORING_TOKEN=""

# Parallel Judge0 executions per API/worker process. For 300-400 concurrent candidates on a
# self-hosted Judge0 with ~20 workers use 16 here and GRADING_CONCURRENCY=8.
EXECUTION_CONCURRENCY=4

# Login throttling: per shared IP (office/campus NAT) and per account per minute.
# Grading lane (submit-time test runs) has its own concurrency and a deep queue so a
# deadline submit storm is never dropped. Defaults to EXECUTION_CONCURRENCY.
# GRADING_EXECUTION_CONCURRENCY=16

AUTH_RATE_LIMIT_PER_IP=600
AUTH_RATE_LIMIT_PER_ACCOUNT=20

# Durable assessment grading. Start npm run worker:grading before enabling.
ASYNC_GRADING=0
GRADING_CONCURRENCY=2
