DATABASE_URL="postgresql://wissen:wissen-local-dev@localhost:5432/wissen_code?schema=public"
JWT_SECRET=""
PORT=4001
REDIS_URL="redis://localhost:6379"

# Use live mode for real execution and generated-question approval.
JUDGE_MODE=mock
JUDGE0_API_URL="https://ce.judge0.com"

# Optional AI workflows; never expose this key to the frontend.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"

# Deployment and frontend origins (comma-separated, no trailing slash).
APP_URL="http://localhost:3000"
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"
TRUST_PROXY=0
JUDGE0_API_KEY=""

# Optional durable invitation/recovery email delivery. Run npm run worker:mail.
RESEND_API_KEY=""
MAIL_FROM=""

# Optional company SSO. Create staff accounts before their first SSO login.
OIDC_ISSUER=""
OIDC_CLIENT_ID=""
OIDC_CLIENT_SECRET=""

# Optional private video relay configuration; use your own STUN/TURN service.
WEBRTC_ICE_SERVERS='[]'

# Optional signed ATS event notifications.
ATS_WEBHOOK_URL=""
ATS_WEBHOOK_SECRET=""

# Protects the Prometheus metrics endpoint; use a separate random secret.
MONITORING_TOKEN=""

# Per API/worker process; tune to the isolated provider capacity.
EXECUTION_CONCURRENCY=4

# Durable assessment grading. Start npm run worker:grading before enabling.
ASYNC_GRADING=0
GRADING_CONCURRENCY=2

# Free-tier alternative: create your own key at https://console.groq.com/keys
# Set AI_PROVIDER=groq to use Groq instead of OpenAI. Free usage is rate-limited.
AI_PROVIDER=openai
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-20b"
# Interview question-set drafts always use Groq, regardless of AI_PROVIDER.
# Optional override for this dedicated agent; otherwise it uses GROQ_MODEL.
# QUESTION_SET_GROQ_MODEL="openai/gpt-oss-120b"
# Optional self-hosted interview transcription (no external speech API)
TRANSCRIPTION_URL=http://127.0.0.1:8765
TRANSCRIPTION_TOKEN=
WHISPER_MODEL=base.en
WHISPER_LANGUAGE=en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Nodemailer: used for bulk invitations and verification emails
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM_NAME="Wissen Code"
