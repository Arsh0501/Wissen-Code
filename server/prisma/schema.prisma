// Wissen-Code Prisma Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String   // bcrypt hash
  role      String   @default("candidate") // "admin" | "recruiter" | "interviewer" | "candidate"
  emailVerifiedAt DateTime?
  isGuest   Boolean  @default(false) // joined through an invite link; no usable password
  createdAt DateTime @default(now())

  inviteRedemptions InviteRedemption[]
  sessions          UserSession[]
  interviewedInterviews Interview[] @relation("InterviewerInterviews")
  candidateInterviews   Interview[] @relation("CandidateInterviews")
  interviewNotes        InterviewNote[]
}

model UserSession {
  id           Int      @id @default(autoincrement())
  userId       Int
  refreshToken String   @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Question {
  id           Int       @id @default(autoincrement())
  title        String
  questionType String @default("coding")
  settings     Json      @default("{}")
  statement    String    // Markdown text for problem statement
  difficulty   String    // "easy" | "medium" | "hard"
  tags         String    @default("[]") // JSON array
  timeLimit    Float     @default(2) // CPU time limit in seconds
  memoryLimit  Int       @default(256000) // Memory limit in KB
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  starterCodes StarterCode[]
  testCases    TestCase[]
  assessments  AssessmentQuestion[]
  submissions  Submission[]
  interviewQuestions InterviewQuestion[]
  interviewSubmissions InterviewSubmission[]
  activeInInterviews   Interview[]
}

model StarterCode {
  id           Int      @id @default(autoincrement())
  questionId   Int
  languageId   Int      // Judge0 language ID (71=Python, 62=Java, 54=C++, 63=JS)
  languageName String   // Display name: "Python", "Java", "C++", "JavaScript"
  code         String   // The starter code template

  question     Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, languageId])
}

model TestCase {
  id             Int      @id @default(autoincrement())
  questionId     Int
  input          String   // stdin input
  expectedOutput String   // Expected stdout output
  isSample       Boolean  @default(false) // true = visible to candidate, false = hidden

  question       Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  results        TestCaseResult[]
}

model Assessment {
  id               Int       @id @default(autoincrement())
  name             String
  description      String    @default("")
  instructions     String    @default("") // Markdown shown on the pre-test screen
  timeLimitMinutes Int       @default(60)
  passingScore     Int       @default(60) // Percentage of total marks needed to pass
  status           String    @default("published") // "draft" | "published" | "archived"
  startAt          DateTime? // Candidates can start only after this (null = anytime)
  endAt            DateTime? // Candidates can start only before this (null = no deadline)
  shuffleQuestions Boolean   @default(false)
  allowedLanguages String    @default("[]") // JSON array of Judge0 language IDs; empty = all
  questionCount    Int?
  difficulty       String    @default("mixed")
  questionTypes    String    @default("[\"coding\"]")
  topics           String    @default("[]")
  requiredSkills   String    @default("[]")
  allowedEmails    String    @default("[]")
  allowedDomains   String    @default("[]")
  maxAttempts      Int       @default(1)
  showResults      Boolean   @default(true) // Show score breakdown to the candidate after submit
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  questions        AssessmentQuestion[]
  submissions      Submission[]
  sessions         AssessmentSession[]
  inviteLinks      InviteLink[]
}

model AssessmentQuestion {
  id           Int        @id @default(autoincrement())
  assessmentId Int
  questionId   Int
  orderIndex   Int        @default(0)
  marks        Int        @default(10)

  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  question     Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, questionId])
}

model Submission {
  id            Int       @id @default(autoincrement())
  assessmentId  Int
  questionId    Int
  candidateName String
  sessionId     Int?
  session       AssessmentSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  languageId    Int
  languageName  String
  code          String
  status        String    @default("submitted") // "submitted" | "grading" | "graded"
  score         Float     @default(0) // Percentage of test cases passed
  createdAt     DateTime  @default(now())

  assessment    Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  question      Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  testCaseResults TestCaseResult[]
}

model TestCaseResult {
  id           Int      @id @default(autoincrement())
  submissionId Int
  testCaseId   Int
  passed       Boolean  @default(false)
  actualOutput String   @default("")
  statusDesc   String   @default("") // e.g. "Accepted", "Wrong Answer", "TLE", "Runtime Error"
  executionTime Float?  // seconds
  memoryUsed   Int?     // KB

  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  testCase     TestCase   @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
}

model AssessmentSession {
  id              Int       @id @default(autoincrement())
  assessmentId    Int
  candidateName   String
  candidateUserId Int?
  durationMinutes Int?
  attemptNumber   Int @default(1)
  submissions     Submission[]
  startedAt       DateTime  @default(now())
  finishedAt      DateTime? // null = in progress, set on final submit
  gradingStatus String @default("pending")
  gradingStartedAt DateTime?

  assessment      Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  drafts          DraftAnswer[]
  tabSwitches     TabSwitchEvent[]
  pasteEvents     PasteEvent[]

  @@index([assessmentId, candidateName])
  @@unique([assessmentId, candidateUserId, attemptNumber])
}

// One row each time the candidate leaves the exam tab/window during a session
model TabSwitchEvent {
  id          Int      @id @default(autoincrement())
  sessionId   Int
  leftAt      DateTime
  durationMs  Int      // time spent away before returning
  createdAt   DateTime @default(now())

  session     AssessmentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model DraftAnswer {
  id              Int       @id @default(autoincrement())
  sessionId       Int
  questionId      Int
  languageId      Int
  languageName    String
  code            String
  isFlagged       Boolean   @default(false)
  isAnswered      Boolean   @default(false)
  updatedAt       DateTime  @updatedAt

  session         AssessmentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, questionId])
}

// One row each time the candidate pastes text into the code editor during a session
model PasteEvent {
  id          Int      @id @default(autoincrement())
  sessionId   Int
  questionId  Int
  charCount   Int
  lineCount   Int
  occurredAt  DateTime @default(now())

  session     AssessmentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

// Shareable link that lets anyone with it join an assessment without an account
model InviteLink {
  id           Int       @id @default(autoincrement())
  token        String    @unique // random, URL-safe; the secret part of the link
  assessmentId Int
  label        String    @default("")
  maxUses      Int?      // null = unlimited
  expiresAt    DateTime? // null = never
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  assessment   Assessment         @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  redemptions  InviteRedemption[]

  @@index([assessmentId])
}

// One row per person who joined through a link (a returning person is not counted twice)
model InviteRedemption {
  id        Int      @id @default(autoincrement())
  inviteId  Int
  userId    Int
  createdAt DateTime @default(now())

  invite    InviteLink @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([inviteId, userId])
}

// ─── INTERVIEW SYSTEM ──────────────────────────────────────────

model Interview {
  id                 Int                   @id @default(autoincrement())
  title              String
  description        String                @default("")
  interviewerId      Int
  candidateName      String
  candidateEmail     String
  candidateId        Int?                  // Optional link to existing User
  roomToken          String                @unique // Random secure access token for candidate
  status             String                @default("scheduled") // "scheduled" | "in_progress" | "completed" | "cancelled"
  scheduledAt        DateTime?
  startedAt          DateTime?
  endedAt            DateTime?
  currentQuestionId  Int?
  codeRevision       Int                   @default(0)
  currentCode        String                @default("")
  currentLanguageId  Int                   @default(71) // Default: Python (71)
  timeLimitMinutes   Int                   @default(60)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  interviewer        User                  @relation("InterviewerInterviews", fields: [interviewerId], references: [id])
  candidate          User?                 @relation("CandidateInterviews", fields: [candidateId], references: [id])
  currentQuestion    Question?             @relation(fields: [currentQuestionId], references: [id])

  questions          InterviewQuestion[]
  sessions           InterviewSession[]
  submissions        InterviewSubmission[]
  notes              InterviewNote[]
  events             InterviewEvent[]
  plan               InterviewPlan?
  evaluations        InterviewEvaluation[]

  @@index([interviewerId])
  @@index([roomToken])
  @@index([status])
}

model InterviewQuestion {
  id             Int        @id @default(autoincrement())
  interviewId    Int
  questionId     Int
  orderIndex     Int        @default(0)
  candidateAnswer String @default("")
  status         String     @default("pending") // "pending" | "active" | "completed"
  notes          String     @default("")

  interview      Interview  @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  question       Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([interviewId, questionId])
}

model InterviewSession {
  id              Int        @id @default(autoincrement())
  interviewId     Int
  participantRole String     // "interviewer" | "candidate"
  participantName String
  socketId        String?
  ipAddress       String?
  userAgent       String?
  connectedAt     DateTime   @default(now())
  disconnectedAt  DateTime?

  interview       Interview  @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@index([interviewId])
}

model InterviewSubmission {
  id             Int        @id @default(autoincrement())
  interviewId    Int
  questionId     Int
  submittedBy    String     // "candidate" | "interviewer"
  languageId     Int
  languageName   String
  code           String
  score          Float      @default(0) // Percentage of test cases passed (0-100)
  status         String     @default("submitted") // "submitted" | "graded"
  results        String     @default("[]") // Serialized JSON test case results
  createdAt      DateTime   @default(now())

  interview      Interview  @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  question       Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([interviewId, questionId])
}

model InterviewNote {
  id           Int        @id @default(autoincrement())
  interviewId  Int
  authorId     Int
  category     String     @default("general") // "technical" | "communication" | "problem_solving" | "general"
  rating       Int?       // Optional rating 1-5
  content      String
  isPrivate    Boolean    @default(true) // Hidden from candidate
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  interview    Interview  @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  author       User       @relation(fields: [authorId], references: [id])

  @@index([interviewId])
}

model InterviewEvent {
  id           Int        @id @default(autoincrement())
  interviewId  Int
  eventType    String     // "CANDIDATE_JOINED", "CODE_CHANGED", "CODE_EXECUTED", etc.
  actorRole    String     // "interviewer" | "candidate" | "system"
  payload      String     @default("{}") // JSON string payload
  createdAt    DateTime   @default(now())

  interview    Interview  @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@index([interviewId, eventType])
}


model AIQuestionDraft {
  id Int @id @default(autoincrement())
  authorId Int
  content Json
  revision Int @default(1)
  status String @default("draft")
  validation Json?
  validatedRevision Int?
  approvedBy Int?
  approvedAt DateTime?
  questionId Int? @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InterviewPlan {
  id Int @id @default(autoincrement())
  interviewId Int @unique
  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  jobRequirements String
  candidateExperience String
  requiredSkills Json
  durationMinutes Int
  sections Json
  updatedAt DateTime @updatedAt
}

model InterviewEvaluation {
  id Int @id @default(autoincrement())
  interviewId Int
  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  questionId Int
  authorId Int
  candidateAnswer String @default("")
  candidateCode String @default("")
  executionResults Json
  notes String @default("")
  skills Json
  observations Json
  status String @default("draft")
  revision Int @default(1)
  updatedAt DateTime @updatedAt
  @@unique([interviewId, questionId, authorId])
}

model AIJob {
  id String @id @default(uuid())
  authorId Int
  interviewId Int?
  kind String
  status String @default("queued")
  input Json
  output Json?
  error String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([authorId, createdAt])
  @@index([interviewId, kind])
}

model AccountToken {
  id String @id @default(uuid())
  userId Int
  purpose String
  tokenHash String @unique
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime @default(now())
  @@index([userId, purpose])
}

model OutboundMessage {
  id String @id @default(uuid())
  authorId Int?
  recipient String
  subject String
  body String
  kind String @default("email")
  status String @default("pending")
  attempts Int @default(0)
  scheduledAt DateTime @default(now())
  lockedAt DateTime?
  deliveredAt DateTime?
  providerId String?
  error String?
  createdAt DateTime @default(now())
  @@index([status, scheduledAt])
}

model AuditEvent {
  id Int @id @default(autoincrement())
  actorId Int?
  action String
  resource String
  resourceId String
  detail Json @default("{}")
  createdAt DateTime @default(now())
  @@index([resource, resourceId, createdAt])
}

model IntegrityReview {
  id Int @id @default(autoincrement())
  assessmentId Int
  submissionId Int
  comparedSubmissionId Int
  reviewerId Int
  decision String
  notes String
  updatedAt DateTime @updatedAt
  @@unique([submissionId, comparedSubmissionId])
}

model AssessmentAccommodation {
  id Int @id @default(autoincrement())
  assessmentId Int
  candidateUserId Int
  extraMinutes Int @default(0)
  reason String
  authorId Int
  @@unique([assessmentId, candidateUserId])
}

model OIDCRequest {
  stateHash String @id
  verifier String
  nonce String
  expiresAt DateTime
}

model OIDCIdentity {
  id Int @id @default(autoincrement())
  issuer String
  subject String
  userId Int
  @@unique([issuer, subject])
}
