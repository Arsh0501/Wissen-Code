// Wissen-Code Prisma Schema
// Using SQLite for prototype — swap to PostgreSQL by changing provider + DATABASE_URL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String   // bcrypt hash
  role      String   @default("candidate") // "admin" | "candidate"
  isGuest   Boolean  @default(false) // joined through an invite link; no usable password
  createdAt DateTime @default(now())

  inviteRedemptions InviteRedemption[]
}

model Question {
  id           Int       @id @default(autoincrement())
  title        String
  statement    String    // Markdown text for problem statement
  difficulty   String    // "easy" | "medium" | "hard"
  tags         String    @default("[]") // JSON array stored as string (SQLite compat)
  timeLimit    Float     @default(2) // CPU time limit in seconds
  memoryLimit  Int       @default(256000) // Memory limit in KB
  type         String    @default("coding") // "coding" | "mcq"
  options      String    @default("[]") // MCQ only: JSON [{ id, text }]
  correctOptions String  @default("[]") // MCQ only: JSON array of correct option ids
  explanation  String    @default("") // MCQ only: why the answer is correct (admin-facing)
  topic        String    @default("")
  skills       String    @default("[]") // JSON array of skills the question assesses
  source       String    @default("manual") // "manual" | "ai"
  status       String    @default("active") // "active" | "pending_review" | "rejected" — only active questions can be used
  validation   String    @default("") // JSON report from the last AI validation run
  referenceSolution String @default("") // Coding: Python solution used to verify test cases
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  starterCodes StarterCode[]
  testCases    TestCase[]
  assessments  AssessmentQuestion[]
  submissions  Submission[]
}

model StarterCode {
  id           Int      @id @default(autoincrement())
  questionId   Int
  languageId   Int      // Judge0 language ID (71=Python, 62=Java, 54=C++, 63=JS)
  languageName String   // Display name: "Python", "Java", "C++", "JavaScript"
  code         String   // The starter code template

  question     Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, languageId])
}

model TestCase {
  id             Int      @id @default(autoincrement())
  questionId     Int
  input          String   // stdin input
  expectedOutput String   // Expected stdout output
  isSample       Boolean  @default(false) // true = visible to candidate, false = hidden

  question       Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  results        TestCaseResult[]
}

model Assessment {
  id               Int       @id @default(autoincrement())
  name             String
  description      String    @default("")
  instructions     String    @default("") // Markdown shown on the pre-test screen
  timeLimitMinutes Int       @default(60)
  passingScore     Int       @default(60) // Percentage of total marks needed to pass
  status           String    @default("published") // "draft" | "published" | "archived"
  startAt          DateTime? // Candidates can start only after this (null = anytime)
  endAt            DateTime? // Candidates can start only before this (null = no deadline)
  shuffleQuestions Boolean   @default(false)
  allowedLanguages String    @default("[]") // JSON array of Judge0 language IDs; empty = all
  showResults      Boolean   @default(true) // Show score breakdown to the candidate after submit
  difficulty       String    @default("mixed") // "mixed" | "easy" | "medium" | "hard" — target level
  topics           String    @default("[]") // JSON array of topics the assessment covers
  questionTypes    String    @default("[\"coding\"]") // JSON array: "coding" | "mcq"
  questionCount    Int?      // Questions each candidate gets; null = all selected. Fewer = random subset per candidate
  shuffleOptions   Boolean   @default(false) // Shuffle MCQ option order per candidate
  maxAttempts      Int       @default(1)
  accessMode       String    @default("anyone") // "anyone" | "restricted" (allowedEmails only) | "invite_only" (share links only)
  allowedEmails    String    @default("[]") // JSON: exact emails and/or "@domain.com" entries, used when accessMode = restricted
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  questions        AssessmentQuestion[]
  submissions      Submission[]
  sessions         AssessmentSession[]
  inviteLinks      InviteLink[]
}

model AssessmentQuestion {
  id           Int        @id @default(autoincrement())
  assessmentId Int
  questionId   Int
  orderIndex   Int        @default(0)
  marks        Int        @default(10)

  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  question     Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, questionId])
}

model Submission {
  id            Int       @id @default(autoincrement())
  assessmentId  Int
  questionId    Int
  candidateName String
  languageId    Int
  languageName  String
  code          String
  status        String    @default("submitted") // "submitted" | "grading" | "graded"
  score         Float     @default(0) // Percentage of test cases passed
  createdAt     DateTime  @default(now())

  assessment    Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  question      Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  testCaseResults TestCaseResult[]
}

model TestCaseResult {
  id           Int      @id @default(autoincrement())
  submissionId Int
  testCaseId   Int
  passed       Boolean  @default(false)
  actualOutput String   @default("")
  statusDesc   String   @default("") // e.g. "Accepted", "Wrong Answer", "TLE", "Runtime Error"
  executionTime Float?  // seconds
  memoryUsed   Int?     // KB

  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  testCase     TestCase   @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
}

model AssessmentSession {
  id              Int       @id @default(autoincrement())
  assessmentId    Int
  candidateName   String
  startedAt       DateTime  @default(now())
  finishedAt      DateTime? // null = in progress, set on final submit
  attempt         Int       @default(1)
  questionIds     String    @default("") // JSON ids of this candidate's questions when the assessment uses a random subset; "" = all

  assessment      Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  drafts          DraftAnswer[]
  tabSwitches     TabSwitchEvent[]
  pasteEvents     PasteEvent[]

  @@unique([assessmentId, candidateName])
}

// One row each time the candidate leaves the exam tab/window during a session
model TabSwitchEvent {
  id          Int      @id @default(autoincrement())
  sessionId   Int
  leftAt      DateTime
  durationMs  Int      // time spent away before returning
  createdAt   DateTime @default(now())

  session     AssessmentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model DraftAnswer {
  id              Int       @id @default(autoincrement())
  sessionId       Int
  questionId      Int
  languageId      Int
  languageName    String
  code            String
  isFlagged       Boolean   @default(false)
  isAnswered      Boolean   @default(false)
  updatedAt       DateTime  @updatedAt

  session         AssessmentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, questionId])
}

// One row each time the candidate pastes text into the code editor during a session
model PasteEvent {
  id          Int      @id @default(autoincrement())
  sessionId   Int
  questionId  Int
  charCount   Int
  lineCount   Int
  occurredAt  DateTime @default(now())

  session     AssessmentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

// Shareable link that lets anyone with it join an assessment without an account
model InviteLink {
  id           Int       @id @default(autoincrement())
  token        String    @unique // random, URL-safe; the secret part of the link
  assessmentId Int
  label        String    @default("")
  maxUses      Int?      // null = unlimited
  expiresAt    DateTime? // null = never
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  assessment   Assessment         @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  redemptions  InviteRedemption[]

  @@index([assessmentId])
}

// One row per person who joined through a link (a returning person is not counted twice)
model InviteRedemption {
  id        Int      @id @default(autoincrement())
  inviteId  Int
  userId    Int
  createdAt DateTime @default(now())

  invite    InviteLink @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([inviteId, userId])
}

// Score snapshot of an earlier attempt, kept when a candidate retakes an assessment
model AttemptHistory {
  id            Int      @id @default(autoincrement())
  assessmentId  Int
  candidateName String
  attempt       Int
  startedAt     DateTime
  finishedAt    DateTime?
  percentage    Float
  passed        Boolean
  marksObtained Float
  totalMarks    Int
  createdAt     DateTime @default(now())

  @@index([assessmentId, candidateName])
}

// A live interview: the AI-assisted plan, what was asked, and the interviewer's evaluation
model Interview {
  id                  Int       @id @default(autoincrement())
  candidateName       String
  candidateEmail      String    @default("")
  role                String    @default("")
  jobRequirements     String    @default("")
  candidateExperience String    @default("")
  skills              String    @default("[]") // JSON array of required skills
  durationMinutes     Int       @default(45)
  scheduledAt         DateTime?
  status              String    @default("planned") // "planned" | "in_progress" | "completed"
  plan                String    @default("[]") // JSON [{ topic, minutes, goals, questions: string[] }]
  skillRatings        String    @default("[]") // JSON [{ skill, rating (1-5), comment }]
  recommendation      String    @default("") // "strong_hire" | "hire" | "no_hire" | "strong_no_hire" | ""
  summary             String    @default("")
  interviewerId       Int?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  questions           InterviewQuestion[]
}

model InterviewQuestion {
  id              Int       @id @default(autoincrement())
  interviewId     Int
  orderIndex      Int       @default(0)
  section         String    @default("") // plan topic this question belongs to
  prompt          String
  answer          String    @default("") // candidate's spoken/written answer, as captured by the interviewer
  code            String    @default("")
  languageId      Int       @default(71)
  executionResult String    @default("") // JSON of the last run
  notes           String    @default("") // interviewer's private notes
  aiObservations  String    @default("") // JSON [{ skill, observation, sentiment, evidence: [...] }]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  interview       Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@index([interviewId])
}
