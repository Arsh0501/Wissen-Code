{
  "name": "wissen-code-server",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:seed": "tsx src/seed.ts",
    "db:verify-mock": "tsx src/verify-mock-data.ts",
    "test": "NODE_ENV=test JUDGE_MODE=mock tsx --test src/test/*.test.ts",
    "worker": "tsx src/ai/worker.ts",
    "worker:start": "node dist/ai/worker.js",
    "db:seed-users": "tsx src/seed-users.ts",
    "db:seed-load": "tsx src/load-seed.ts",
    "worker:mail": "tsx src/platform/worker.ts",
    "worker:mail:start": "node dist/platform/worker.js",
    "worker:grading": "tsx src/platform/grading-worker.ts",
    "worker:grading:start": "node dist/platform/grading-worker.js",
    "doctor": "tsx src/config/doctor.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.9.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "axios": "^1.7.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^6.3.14",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.21.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.2.1",
    "openai": "^7.25.0",
    "openid-client": "^6.8.8",
    "puppeteer": "^25.11.0",
    "socket.io": "^4.8.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "prisma": "^6.9.0",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "^8.0.0"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
