{
  "name": "wissen-code-server",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:seed": "tsx src/seed.ts",
    "db:verify-mock": "tsx src/verify-mock-data.ts",
    "interview:reset": "tsx -e \"import prisma from './src/prisma'; prisma.interviewSession.update({ where: { id: 1 }, data: { status: 'waiting', currentQuestionId: null } }).then(() => console.log('Demo interview session reset to State A!'));\"",
    "interview:push-question": "node scratch/simulate_interviewer.cjs open_question",
    "interview:send-chat": "node scratch/simulate_interviewer.cjs send_chat",
    "interview:send-card": "node scratch/simulate_interviewer.cjs send_question_card"
  },
  "dependencies": {
    "@prisma/client": "^6.9.0",
    "axios": "^1.7.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.2",
    "puppeteer": "^25.11.0",
    "socket.io": "^4.8.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.0.0",
    "@types/socket.io": "^3.0.1",
    "prisma": "^6.9.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "prisma": {
    "seed": "tsx src/seed.ts"
  }
}
