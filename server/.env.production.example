# Inject secrets through your deployment environment. Never reuse development data.
NODE_ENV=production
PORT=4001
DATABASE_URL="postgresql://APP_USER:REPLACE_ME@DATABASE_HOST:5432/wissen_production?schema=public&connection_limit=25&pool_timeout=10"
REDIS_URL="rediss://REDIS_HOST:6379/0"
JWT_SECRET=""
APP_URL="https://assessments.example.com"
CORS_ORIGINS="https://assessments.example.com"
TRUST_PROXY=1
JUDGE_MODE=live
JUDGE0_API_URL="https://YOUR_JUDGE_HOST"
JUDGE0_API_KEY=""
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"
MONITORING_TOKEN=""
ASYNC_GRADING=1
GRADING_CONCURRENCY=8
EXECUTION_CONCURRENCY=16

# Nodemailer: Gmail via Google Cloud Console OAuth client (preferred) or SMTP fallback.
MAIL_FROM_NAME="Wissen Code"
MAIL_TIMEZONE="Asia/Kolkata"
GOOGLE_MAIL_USER=""
GOOGLE_MAIL_CLIENT_ID=""
GOOGLE_MAIL_CLIENT_SECRET=""
GOOGLE_MAIL_REFRESH_TOKEN=""
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
