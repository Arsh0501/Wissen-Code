NODE_ENV=production
PORT=4001
DATABASE_URL="postgresql://APP_USER:REPLACE_ME@DATABASE_HOST:5432/wissen_production?schema=public&connection_limit=10&pool_timeout=10"
REDIS_URL="rediss://REDIS_HOST:6379/0"
JWT_SECRET=""
